# Server Configuration
PORT=5001
NODE_ENV=development

# SMTP Configuration (Existing Website)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECEIVER=

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Supabase Database & Vector Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chatbot RAG Parameters
CHATBOT_TOP_K=5
CHATBOT_MIN_SIMILARITY=0.5
CHATBOT_MAX_HISTORY=10

# Rate Limiting (Window in ms, Max requests)
CHATBOT_RATE_LIMIT_WINDOW_MS=900000
CHATBOT_RATE_LIMIT_MAX=100
