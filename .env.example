# Zoho Mail SMTP Configuration
# Use smtp.zoho.in for India Data Center accounts, or smtp.zoho.com for Global / US accounts.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=your-email@yourdomain.com
ZOHO_SMTP_PASS=your-zoho-app-password

# Standard / Fallback SMTP Environment Variables
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-zoho-app-password
SMTP_FROM=your-email@yourdomain.com
CONTACT_RECEIVER=info@vyomalearn.com

